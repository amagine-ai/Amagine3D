# Web server port used by pnpm dev and pnpm start. Defaults to 6160.
PORT=6160

# Server-only custom OpenAI-compatible model gateway credentials.
AMAGINE3D_MODEL_GATEWAY_API_KEY=
AMAGINE3D_MODEL_GATEWAY_BASE_URL=https://gateway.example.com/v1
AMAGINE3D_WEB_SEARCH_MODEL=model-id
# Initial/default CAD model. Saved browser model profiles take precedence for
# later runs; API keys remain in this server-only file.
AMAGINE3D_CAD_MODEL=model-id
TAVILY_API_KEY=
# Optional; defaults to https://api.tavily.com.
TAVILY_BASE_URL=https://api.tavily.com
