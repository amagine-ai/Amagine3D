{
  "name": "amagine3d",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "npm run python:setup && concurrently -k -n api,web -c blue,white \"tsx watch server/index.ts\" \"vite\"",
    "doctor": "tsx server/doctor.ts",
    "licenses:check": "node scripts/check-licenses.mjs",
    "styles:prune": "node scripts/prune-workbench-css.mjs --write",
    "python:setup": "node scripts/setup-python.mjs",
    "start": "npm run python:setup && tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@amagine3d/a3d-runtime": "file:packages/a3d-runtime",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.4",
    "postcss": "8.5.26",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
