# OpenAI Responses-compatible model gateway
LLM_API_KEY=replace-me
LLM_MODEL=openai/gpt-5.5
LLM_BASE_URL=https://your-gateway.example.com/v1

# CODEX_API_KEY and OPENAI_API_KEY are accepted when LLM_API_KEY is unset.
# OPENAI_BASE_URL is accepted when LLM_BASE_URL is unset.

# Optional Codex runtime overrides
LLM_API_TYPE=openai-responses
LLM_THINKING_LEVEL=medium
# Native live web search and workspace network access are enabled by default.
# Set false here to disable them; the browser and chat requests cannot override it.
CODEX_WEB_SEARCH_ENABLED=true

# Local runtime
PORT=6161
WEB_PORT=6160
# Stop after 30 minutes without a Codex event.
AGENT_RUN_IDLE_TIMEOUT_MS=1800000
# Absolute safety cap for a single run, even when it remains active.
AGENT_RUN_HARD_TIMEOUT_MS=7200000
